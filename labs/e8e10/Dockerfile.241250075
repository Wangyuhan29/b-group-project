# Personal extension of the per-student course DRAFT container; keep base content pinned.
FROM course1027-draft@sha256:edcc9be43e726802ae0d079122422cc04fd6baeed3b5c11c3b0bf4aa064114c3
USER root
RUN apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=60 update \
 && apt-get install -y --no-install-recommends gcc make libc6-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace/labs/e8e10
