# Personal extension of the existing course DRAFT container; keep base content pinned.
FROM course1027-draft@sha256:a4561aac37820ffaaceb6ac5124a236a0541fa40a8fd25539204b91b8ca17f03
USER root
RUN apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=60 update \
 && apt-get install -y --no-install-recommends gcc make libc6-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace/labs/e8e10
